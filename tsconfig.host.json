{
	"compilerOptions": {
		"module": "CommonJS",
		"target": "ES2022",
		"outDir": "out",
		"lib": ["ES2022"],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"skipLibCheck": true,
		"types": ["mocha", "node"],
		// `#src/*` resolves through the root `package.json`'s `imports` field, which
		// Node itself reads at `require()` time - unlike `compilerOptions.paths`,
		// which `tsc` only consults for typechecking and never rewrites into the
		// emitted `require()` call. That's what makes it safe for this project:
		// no bundler runs between `tsc`'s CommonJS emit and the extension host
		// loading `out/host.js`. `vscode:sentinel` writes the matching `imports`
		// map into `out/package.json`, since Node resolves `imports` from the
		// nearest `package.json` to the *requiring* file, not the root one.
		"moduleResolution": "bundler",
		"resolvePackageJsonImports": true
	},
	"include": [
		"src/host.ts",
		"src/host/**/*",
		"src/shared/**/*",
		"src/test/**/*",
		// Pure and dependency-free host-side modules, grouped here rather than
		// scattered through `src/lib/**` — which would drag the whole webview lib
		// tree (zod, React, the retext stack) into the CommonJS host build.
		"src/lib/host/**/*"
	],
	"exclude": [
		"node_modules",
		"out",
		// esbuild's entry point, never tsc's - see the file's own comment.
		"src/host/agent-sdk-bundle.ts",
		// Its own esbuild bundle and its own process - pulls in the retext stack
		// and hunspell dictionaries, which this dependency-free CJS build doesn't
		// vendor.
		"src/mcp",
		// This project has no DOM lib and no vitest types.
		"src/lib/host/**/*.test.ts"
	]
}
