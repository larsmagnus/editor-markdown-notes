{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["import", "react", "react-perf", "unicorn", "typescript", "oxc"],
	"ignorePatterns": ["node_modules/", "public/"],
	"rules": {
		"consistent-type-specifier-style": "error",
		"react/rules-of-hooks": "error",
		"react/only-export-components": ["warn", { "allowConstantExport": true }],
		"no-restricted-imports": [
			"error",
			{
				"patterns": [
					{
						"group": ["./*", "../**", ".", ".."],
						"message": "Use the `#src/*` subpath import instead of relative imports."
					}
				]
			}
		]
	},
	"overrides": [
		{
			"files": ["src/components/ui/**"],
			"rules": {
				"react/only-export-components": "off",
				"no-restricted-imports": "off"
			}
		},
		{
			// Hand-written, not `tsc`-compiled - see the file's own comment. It loads
			// a sibling `.mjs` chunk that's a bundler output artifact, not a module
			// under `src/`, so `#src/*` cannot reach it.
			"files": ["src/host/load-esm-bundle.cjs"],
			"rules": {
				"no-restricted-imports": "off"
			}
		},
		{
			// Config-adjacent, not part of the `src/` module graph, so `#src/*`
			// cannot reach these - a relative import to `./vite/*` is the only
			// route in.
			"files": ["vite.config.ts", "vite.*.config.ts"],
			"rules": {
				"no-restricted-imports": "off"
			}
		},
		{
			// Vite resolves `?worker&inline` to a Worker constructor and
			// `vite/client` types it, but oxlint's resolver reads the query as part
			// of the path and reports a missing default export.
			"files": ["src/lib/text-tools/analyze-client.ts"],
			"rules": {
				"import/default": "off"
			}
		}
	]
}
