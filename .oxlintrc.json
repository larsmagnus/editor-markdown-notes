{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["import", "react", "react-perf", "unicorn", "typescript", "oxc"],
	"ignorePatterns": ["node_modules/", "public/"],
	"rules": {
		"consistent-type-specifier-style": "error",
		"react/rules-of-hooks": "error",
		"react/only-export-components": ["warn", { "allowConstantExport": true }]
	},
	"overrides": [
		{
			"files": ["src/components/ui/**"],
			"rules": {
				"react/only-export-components": "off"
			}
		},
		{
			// Vite resolves `?worker&inline` to a Worker constructor and
			// `vite/client` types it, but oxlint's resolver reads the query as part
			// of the path and reports a missing default export.
			"files": ["src/lib/text-tools/analyze-client.ts"],
			"rules": {
				"import/default": "off"
			}
		}
	]
}
