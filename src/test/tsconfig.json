{
	// Here for the editor only. The language service picks a file's project by
	// walking up from the file, and nothing in the root solution reaches this
	// folder - `tsconfig.app.json` excludes it, and `tsconfig.json` references
	// only app and node. Without this these suites land in an inferred project
	// with no `types` and no `vscode`, so every `suite`, `test` and `assert`
	// reads as undefined in the editor while `pnpm typecheck`, which points tsc
	// at `tsconfig.extension.json` by hand, stays green.
	//
	// Nothing builds through this file: `tsconfig.extension.json` still compiles
	// these suites into `out/`, and inheriting from it is what keeps the two
	// answers the same.
	"extends": "../../tsconfig.extension.json",
	"include": ["."]
}
