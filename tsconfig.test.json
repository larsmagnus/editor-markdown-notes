{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
		"target": "ES2023",
		"lib": ["ES2023", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"types": ["@playwright/test", "node"],
		"paths": {
			"@/*": ["./src/*"],
			"@/e2e/*": ["./e2e/*"]
		}
	},
	"include": ["e2e/**/*.ts", "src/lib/vscode-api.ts"]
}
