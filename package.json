{
	"name": "editor-markdown-notes",
	"displayName": "Editor Markdown Notes",
	"description": "An integrated live markdown editor for VS Code, built for the AI-first era",
	"publisher": "larsmagnus",
	"author": "Lars Magnus Klavenes <larsmagnus@gmail.com> (https://larsmagnus.co)",
	"license": "MIT",
	"version": "0.25.0",
	"type": "module",
	"imports": {
		"#src/*": [
			"./src/*.ts",
			"./src/*.tsx",
			"./src/*"
		],
		"#e2e/*": [
			"./e2e/*.ts",
			"./e2e/*"
		]
	},
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/larsmagnus/editor-markdown-notes"
	},
	"engines": {
		"vscode": "^1.101.0"
	},
	"categories": [
		"Other",
		"Formatters",
		"Notebooks"
	],
	"keywords": [
		"markdown",
		"editor",
		"preview",
		"wysiwyg",
		"tiptap",
		"notes",
		"writing",
		"formatting"
	],
	"icon": "public/icon-editor-markdown-notes.png",
	"activationEvents": [
		"onLanguage:markdown",
		"onStartupFinished"
	],
	"main": "./out/host.js",
	"contributes": {
		"customEditors": [
			{
				"viewType": "editor-markdown-notes.markdownEditor",
				"displayName": "Editor Markdown Notes",
				"selector": [
					{
						"filenamePattern": "*.md"
					},
					{
						"filenamePattern": "*.markdown"
					},
					{
						"filenamePattern": "*.mdown"
					},
					{
						"filenamePattern": "*.mkd"
					},
					{
						"filenamePattern": "*.mdx"
					},
					{
						"filenamePattern": "*.txt"
					}
				],
				"priority": "option"
			}
		],
		"configuration": {
			"title": "Editor Markdown Notes",
			"properties": {
				"editorMarkdownNotes.centerContent": {
					"type": "boolean",
					"default": false,
					"description": "Center the editor content horizontally when full width is off."
				},
				"editorMarkdownNotes.hideToolbar": {
					"type": "boolean",
					"default": false,
					"description": "Hide the editor's toolbar. The raw, full width, text tools, theme and spelling language toggles remain available from the command palette."
				},
				"editorMarkdownNotes.italicMarker": {
					"type": "string",
					"enum": [
						"_",
						"*"
					],
					"default": "_",
					"description": "Marker used when italicizing text from the editor (toolbar, bubble menu or Cmd/Ctrl+I) rather than by typing markdown syntax directly. Italics already present in a file, however they were written, keep their original marker."
				},
				"editorMarkdownNotes.textToolsTargetAge": {
					"type": "integer",
					"default": 16,
					"minimum": 5,
					"maximum": 30,
					"description": "Reading age the text tools score sentences against. A sentence too hard for this age reads as \"hard\"; one still too hard six years later, \"very hard\"."
				},
				"editorMarkdownNotes.claudePromptTemplate": {
					"type": "string",
					"default": "Read %@ so I can ask you questions about it.",
					"maxLength": 500,
					"editPresentation": "multilineText",
					"description": "Prompt sent to `claude` by the toolbar's \"Open in Claude\" action. `%@` is replaced with the note as an at-reference (`@notes/roadmap.md`), `%s` with its bare path relative to the workspace root."
				},
				"editorMarkdownNotes.claudeInlinePromptTemplate": {
					"type": "string",
					"default": "Read %@, then focus on the part of it that starts with \"%c\" so I can ask you questions about that.",
					"maxLength": 500,
					"editPresentation": "multilineText",
					"description": "Prompt sent to `claude` by \"Open in Claude\" on one part of a note, such as a diagram. Takes the same `%@` and `%s` tokens as the note-wide template, plus `%c` for the source of the part in question (flattened to one line and truncated)."
				},
				"editorMarkdownNotes.imageCopyDirectory": {
					"type": "string",
					"default": "assets",
					"description": "Where the slash command's \"image\" action copies a file picked from outside the workspace, relative to the open document's folder. A file already inside the workspace is referenced in place instead of being copied."
				}
			}
		},
		"commands": [
			{
				"command": "editor-markdown-notes.openFile",
				"title": "Open file",
				"category": "Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.openMarkdownEditor",
				"title": "Open with Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.toggleRaw",
				"title": "Toggle raw markdown",
				"category": "Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.toggleFullWidth",
				"title": "Toggle full width",
				"category": "Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.toggleTextTools",
				"title": "Toggle text tools",
				"category": "Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.selectTheme",
				"title": "Select theme",
				"category": "Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.selectSpellingLanguage",
				"title": "Select spelling language",
				"category": "Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.openInTextEditor",
				"title": "Open in text editor",
				"category": "Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.toggleHideToolbar",
				"title": "Toggle toolbar",
				"category": "Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.showLogs",
				"title": "Show logs",
				"category": "Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.addDictionaryWords",
				"title": "Add words to dictionary",
				"category": "Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.openPdfAsNotes",
				"title": "Open PDF as markdown",
				"category": "Editor Markdown Notes"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "editor-markdown-notes.openMarkdownEditor",
					"when": "resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkd || resourceExtname == .mdx || resourceExtname == .txt",
					"group": "navigation@1"
				},
				{
					"command": "editor-markdown-notes.openPdfAsNotes",
					"when": "resourceExtname == .pdf",
					"group": "navigation@1"
				}
			],
			"editor/context": [
				{
					"command": "editor-markdown-notes.openMarkdownEditor",
					"when": "resourceLangId == markdown || resourceExtname == .mdx || resourceExtname == .txt",
					"group": "1_open@1"
				}
			],
			"editor/title/context": [
				{
					"command": "editor-markdown-notes.openMarkdownEditor",
					"when": "resourceLangId == markdown || resourceExtname == .mdx || resourceExtname == .txt",
					"group": "1_open"
				},
				{
					"command": "editor-markdown-notes.openPdfAsNotes",
					"when": "resourceExtname == .pdf",
					"group": "1_open"
				}
			],
			"commandPalette": [
				{
					"command": "editor-markdown-notes.openFile",
					"when": "resourceLangId == markdown || resourceExtname == .md || resourceExtname == .mdx || resourceExtname == .txt"
				},
				{
					"command": "editor-markdown-notes.openMarkdownEditor",
					"when": "false"
				},
				{
					"command": "editor-markdown-notes.openPdfAsNotes",
					"when": "resourceExtname == .pdf"
				},
				{
					"command": "editor-markdown-notes.toggleRaw",
					"when": "activeCustomEditorId == editor-markdown-notes.markdownEditor"
				},
				{
					"command": "editor-markdown-notes.toggleFullWidth",
					"when": "activeCustomEditorId == editor-markdown-notes.markdownEditor"
				},
				{
					"command": "editor-markdown-notes.toggleTextTools",
					"when": "activeCustomEditorId == editor-markdown-notes.markdownEditor"
				},
				{
					"command": "editor-markdown-notes.selectTheme",
					"when": "activeCustomEditorId == editor-markdown-notes.markdownEditor"
				},
				{
					"command": "editor-markdown-notes.selectSpellingLanguage",
					"when": "activeCustomEditorId == editor-markdown-notes.markdownEditor"
				},
				{
					"command": "editor-markdown-notes.openInTextEditor",
					"when": "activeCustomEditorId == editor-markdown-notes.markdownEditor"
				},
				{
					"command": "editor-markdown-notes.toggleHideToolbar",
					"when": "activeCustomEditorId == editor-markdown-notes.markdownEditor"
				}
			]
		},
		"mcpServerDefinitionProviders": [
			{
				"id": "editor-markdown-notes.text-tools",
				"label": "Markdown Notes Text Tools"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "pnpm run build",
		"vscode:sentinel": "mkdir -p out && echo '{\"type\":\"commonjs\",\"imports\":{\"#src/*\":\"./*.js\"}}' > out/package.json",
		"vscode:bundle-externals": "vite build -c vite.externals.config.ts",
		"vscode:copy-esm-loader": "cp src/host/load-esm-bundle.cjs out/host/load-esm-bundle.cjs",
		"vscode:compile": "tsc -p ./tsconfig.host.json --noEmit && vite build -c vite.host.config.ts && pnpm vscode:bundle-externals && pnpm vscode:copy-esm-loader && pnpm vscode:bundle-mcp && pnpm vscode:sentinel",
		"vscode:watch": "pnpm vscode:sentinel && pnpm vscode:bundle-externals && pnpm vscode:copy-esm-loader && pnpm vscode:bundle-mcp && (tsc -watch -p ./tsconfig.host.json --noEmit & vite build -c vite.host.config.ts --watch)",
		"vscode:package": "pnpm dlx @vscode/vsce@3.9.2 package --no-dependencies",
		"vscode:install": "pnpm install && pnpm vscode:package && code --install-extension editor-markdown-notes-$npm_package_version.vsix",
		"watch": "pnpm vscode:watch",
		"screenshot": "scripts/screenshot.sh",
		"dictionaries:generate": "node scripts/generate-technical-terms.ts",
		"pretest": "pnpm run build && pnpm run lint",
		"test": "pnpm test:unit && pnpm test:extension && pnpm test:e2e",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"test:extension": "vscode-test",
		"test:e2e": "playwright test",
		"dev": "vite",
		"build": "tsc -b && vite build && pnpm vscode:compile",
		"build:web": "vite build",
		"typecheck": "tsc -b --noEmit && tsc -p ./tsconfig.host.json --noEmit",
		"lint": "pnpm typecheck && oxlint --fix && oxfmt",
		"lint:ci": "oxlint && oxfmt --check",
		"release": "pnpm version --message 'chore(release): %s'",
		"complexity": "fta src --config-path fta.json --score-cap 50",
		"duplication": "jscpd -c .jscpd.json",
		"duplication:ci": "jscpd -c .jscpd.json --reporters console,json --threshold 1",
		"knip": "knip",
		"preview": "vite preview",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"vscode:bundle-mcp": "vite build -c vite.mcp.config.ts && node out/mcp/copy-dictionaries.mjs"
	},
