{
	"name": "editor-markdown-notes",
	"displayName": "Editor Markdown Notes",
	"description": "A powerful markdown editor with live preview and rich formatting tools.",
	"publisher": "larsmagnus",
	"author": "Lars Magnus Klavenes <larsmagnus@gmail.com> (https://larsmagnus.co)",
	"license": "MIT",
	"version": "0.9.0",
	"type": "module",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/larsmagnus/editor-markdown-notes"
	},
	"engines": {
		"vscode": "^1.101.0"
	},
	"categories": [
		"Other",
		"Formatters",
		"Notebooks"
	],
	"keywords": [
		"markdown",
		"editor",
		"preview",
		"wysiwyg",
		"tiptap",
		"notes",
		"writing",
		"formatting"
	],
	"icon": "public/icon-editor-markdown-notes.png",
	"activationEvents": [
		"onLanguage:markdown"
	],
	"main": "./out/extension.js",
	"contributes": {
		"customEditors": [
			{
				"viewType": "editor-markdown-notes.markdownEditor",
				"displayName": "Editor Markdown Notes",
				"selector": [
					{
						"filenamePattern": "*.md"
					}
				],
				"priority": "option"
			}
		],
		"configuration": {
			"title": "Editor Markdown Notes",
			"properties": {
				"editorMarkdownNotes.centerContent": {
					"type": "boolean",
					"default": false,
					"description": "Center the editor content horizontally when full width is off."
				},
				"editorMarkdownNotes.hideNav": {
					"type": "boolean",
					"default": false,
					"description": "Hide the editor's top navigation bar. The raw, full width and theme toggles remain available from the command palette."
				}
			}
		},
		"commands": [
			{
				"command": "editor-markdown-notes.openFile",
				"title": "Open file",
				"category": "Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.openMarkdownEditor",
				"title": "Open with Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.toggleRaw",
				"title": "Toggle raw markdown",
				"category": "Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.toggleFullWidth",
				"title": "Toggle full width",
				"category": "Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.selectTheme",
				"title": "Select theme",
				"category": "Editor Markdown Notes"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "editor-markdown-notes.openMarkdownEditor",
					"when": "resourceExtname == .md",
					"group": "navigation@1"
				}
			],
			"editor/context": [
				{
					"command": "editor-markdown-notes.openMarkdownEditor",
					"when": "resourceLangId == markdown",
					"group": "1_open@1"
				}
			],
			"editor/title/context": [
				{
					"command": "editor-markdown-notes.openMarkdownEditor",
					"when": "resourceLangId == markdown",
					"group": "1_open"
				}
			],
			"commandPalette": [
				{
					"command": "editor-markdown-notes.openFile",
					"when": "resourceLangId == markdown || resourceExtname == .md"
				},
				{
					"command": "editor-markdown-notes.openMarkdownEditor",
					"when": "false"
				},
				{
					"command": "editor-markdown-notes.toggleRaw",
					"when": "activeCustomEditorId == editor-markdown-notes.markdownEditor"
				},
				{
					"command": "editor-markdown-notes.toggleFullWidth",
					"when": "activeCustomEditorId == editor-markdown-notes.markdownEditor"
				},
				{
					"command": "editor-markdown-notes.selectTheme",
					"when": "activeCustomEditorId == editor-markdown-notes.markdownEditor"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "pnpm run build",
		"vscode:sentinel": "mkdir -p out && echo '{\"type\":\"commonjs\"}' > out/package.json",
		"vscode:compile": "tsc -p ./tsconfig.extension.json && pnpm vscode:sentinel",
		"vscode:watch": "pnpm vscode:sentinel && tsc -watch -p ./tsconfig.extension.json",
		"watch": "pnpm vscode:watch",
		"pretest": "pnpm run build && pnpm run lint",
		"test": "vscode-test",
		"dev": "vite",
		"build": "tsc -b && vite build && pnpm vscode:compile",
		"typecheck": "tsc -b --noEmit && tsc -p ./tsconfig.extension.json --noEmit",
		"lint": "pnpm typecheck && oxlint --fix && oxfmt",
		"preview": "vite preview"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.1.11",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.1.11",
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"@types/mocha": "^10.0.10",
		"@types/node": "20.x",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@types/vscode": "^1.101.0",
		"@vitejs/plugin-react-swc": "^3.10.2",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"globals": "^16.2.0",
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"postcss": "^8.5.6",
		"tailwindcss": "^4.1.11",
		"tailwindcss-animate": "^1.0.7",
		"tw-animate-css": "^1.3.4",
		"typescript": "^5.8.3",
		"vite": "^7.0.0"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.1.14",
		"@radix-ui/react-dropdown-menu": "^2.1.15",
		"@radix-ui/react-label": "^2.1.7",
		"@radix-ui/react-popover": "^1.1.14",
		"@radix-ui/react-slot": "^1.2.3",
		"@radix-ui/react-toggle": "^1.1.9",
		"@radix-ui/react-toggle-group": "^1.1.10",
		"@tiptap/extension-color": "^2.23.0",
		"@tiptap/extension-link": "^2.23.0",
		"@tiptap/extension-list-item": "^2.23.0",
		"@tiptap/extension-text-style": "^2.23.0",
		"@tiptap/react": "^2.23.0",
		"@tiptap/starter-kit": "^2.23.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"gray-matter": "^4.0.3",
		"lucide-react": "^0.525.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"tailwind-merge": "^3.3.1",
		"tiptap-markdown": "^0.8.10",
		"usehooks-ts": "^3.1.1",
		"zod": "^4.4.3"
	}
}
