{
	"name": "editor-markdown-notes",
	"displayName": "Editor Markdown Notes",
	"description": "A powerful markdown editor with live preview and rich formatting tools.",
	"publisher": "larsmagnus",
	"author": "Lars Magnus Klavenes <larsmagnus@gmail.com> (https://larsmagnus.co)",
	"license": "MIT",
	"version": "0.18.1",
	"type": "module",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/larsmagnus/editor-markdown-notes"
	},
	"engines": {
		"vscode": "^1.101.0"
	},
	"categories": [
		"Other",
		"Formatters",
		"Notebooks"
	],
	"keywords": [
		"markdown",
		"editor",
		"preview",
		"wysiwyg",
		"tiptap",
		"notes",
		"writing",
		"formatting"
	],
	"icon": "public/icon-editor-markdown-notes.png",
	"activationEvents": [
		"onLanguage:markdown"
	],
	"main": "./out/extension.js",
	"contributes": {
		"customEditors": [
			{
				"viewType": "editor-markdown-notes.markdownEditor",
				"displayName": "Editor Markdown Notes",
				"selector": [
					{
						"filenamePattern": "*.md"
					}
				],
				"priority": "option"
			}
		],
		"configuration": {
			"title": "Editor Markdown Notes",
			"properties": {
				"editorMarkdownNotes.centerContent": {
					"type": "boolean",
					"default": false,
					"description": "Center the editor content horizontally when full width is off."
				},
				"editorMarkdownNotes.hideToolbar": {
					"type": "boolean",
					"default": false,
					"description": "Hide the editor's toolbar. The raw, full width, text tools and theme toggles remain available from the command palette."
				},
				"editorMarkdownNotes.italicMarker": {
					"type": "string",
					"enum": [
						"_",
						"*"
					],
					"default": "_",
					"description": "Marker used when italicizing text from the editor (toolbar, bubble menu or Cmd/Ctrl+I) rather than by typing markdown syntax directly. Italics already present in a file, however they were written, keep their original marker."
				},
				"editorMarkdownNotes.textToolsTargetAge": {
					"type": "integer",
					"default": 16,
					"minimum": 5,
					"maximum": 30,
					"description": "Reading age the text tools score sentences against. A sentence too hard for this age reads as \"hard\"; one still too hard six years later, \"very hard\"."
				}
			}
		},
		"commands": [
			{
				"command": "editor-markdown-notes.openFile",
				"title": "Open file",
				"category": "Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.openMarkdownEditor",
				"title": "Open with Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.toggleRaw",
				"title": "Toggle raw markdown",
				"category": "Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.toggleFullWidth",
				"title": "Toggle full width",
				"category": "Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.toggleTextTools",
				"title": "Toggle text tools",
				"category": "Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.selectTheme",
				"title": "Select theme",
				"category": "Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.openInTextEditor",
				"title": "Open in text editor",
				"category": "Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.toggleHideToolbar",
				"title": "Toggle toolbar",
				"category": "Editor Markdown Notes"
			},
			{
				"command": "editor-markdown-notes.showLogs",
				"title": "Show logs",
				"category": "Editor Markdown Notes"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "editor-markdown-notes.openMarkdownEditor",
					"when": "resourceExtname == .md",
					"group": "navigation@1"
				}
			],
			"editor/context": [
				{
					"command": "editor-markdown-notes.openMarkdownEditor",
					"when": "resourceLangId == markdown",
					"group": "1_open@1"
				}
			],
			"editor/title/context": [
				{
					"command": "editor-markdown-notes.openMarkdownEditor",
					"when": "resourceLangId == markdown",
					"group": "1_open"
				}
			],
			"commandPalette": [
				{
					"command": "editor-markdown-notes.openFile",
					"when": "resourceLangId == markdown || resourceExtname == .md"
				},
				{
					"command": "editor-markdown-notes.openMarkdownEditor",
					"when": "false"
				},
				{
					"command": "editor-markdown-notes.toggleRaw",
					"when": "activeCustomEditorId == editor-markdown-notes.markdownEditor"
				},
				{
					"command": "editor-markdown-notes.toggleFullWidth",
					"when": "activeCustomEditorId == editor-markdown-notes.markdownEditor"
				},
				{
					"command": "editor-markdown-notes.toggleTextTools",
					"when": "activeCustomEditorId == editor-markdown-notes.markdownEditor"
				},
				{
					"command": "editor-markdown-notes.selectTheme",
					"when": "activeCustomEditorId == editor-markdown-notes.markdownEditor"
				},
				{
					"command": "editor-markdown-notes.openInTextEditor",
					"when": "activeCustomEditorId == editor-markdown-notes.markdownEditor"
				},
				{
					"command": "editor-markdown-notes.toggleHideToolbar",
					"when": "activeCustomEditorId == editor-markdown-notes.markdownEditor"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "pnpm run build",
		"vscode:sentinel": "mkdir -p out && echo '{\"type\":\"commonjs\"}' > out/package.json",
		"vscode:compile": "tsc -p ./tsconfig.extension.json && pnpm vscode:sentinel",
		"vscode:watch": "pnpm vscode:sentinel && tsc -watch -p ./tsconfig.extension.json",
		"vscode:package": "pnpm dlx @vscode/vsce@3.9.2 package --no-dependencies",
		"vscode:install": "pnpm install && pnpm vscode:package && code --install-extension editor-markdown-notes-$npm_package_version.vsix",
		"watch": "pnpm vscode:watch",
		"pretest": "pnpm run build && pnpm run lint",
		"test": "pnpm test:unit && pnpm test:extension",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"test:extension": "vscode-test",
		"dev": "vite",
		"build": "tsc -b && vite build && pnpm vscode:compile",
		"typecheck": "tsc -b --noEmit && tsc -p ./tsconfig.extension.json --noEmit",
		"lint": "pnpm typecheck && oxlint --fix && oxfmt",
		"lint:ci": "oxlint && oxfmt --check",
		"release": "pnpm version --message 'chore(release): %s'",
		"complexity": "fta src --config-path fta.json --score-cap 50",
		"knip": "knip",
		"preview": "vite preview",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@storybook/addon-mcp": "0.7.0",
		"@storybook/addon-vitest": "10.5.7",
		"@storybook/react-vite": "10.5.7",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "7.0.0",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.3",
		"@types/mocha": "10.0.10",
		"@types/nlcst": "2.0.3",
		"@types/node": "20.x",
		"@types/react": "19.1.8",
		"@types/react-dom": "19.1.6",
		"@types/vscode": "1.101.0",
		"@vitejs/plugin-react-swc": "4.3.3",
		"@vscode/test-cli": "0.0.15",
		"@vscode/test-electron": "3.1.0",
		"fta-cli": "3.0.0",
		"happy-dom": "20.11.1",
		"knip": "6.32.0",
		"oxfmt": "0.62.0",
		"oxlint": "1.77.0",
		"storybook": "10.5.7",
		"tailwindcss": "4.3.3",
		"tailwindcss-animate": "1.0.7",
		"typescript": "7.0.2",
		"vite": "8.2.1",
		"vitest": "4.1.10"
	},
	"dependencies": {
		"@base-ui/react": "1.7.0",
		"@shikijs/langs": "4.4.3",
		"@shikijs/themes": "4.4.3",
		"@tiptap/core": "3.29.2",
		"@tiptap/extension-code": "3.29.2",
		"@tiptap/extension-code-block": "3.29.2",
		"@tiptap/extension-color": "3.29.2",
		"@tiptap/extension-image": "3.29.2",
		"@tiptap/extension-italic": "3.29.2",
		"@tiptap/extension-link": "3.29.2",
		"@tiptap/extension-list-item": "3.29.2",
		"@tiptap/extension-table": "3.29.2",
		"@tiptap/extension-table-cell": "3.29.2",
		"@tiptap/extension-table-header": "3.29.2",
		"@tiptap/extension-table-row": "3.29.2",
		"@tiptap/extension-task-item": "3.29.2",
		"@tiptap/extension-task-list": "3.29.2",
		"@tiptap/extension-text-style": "3.29.2",
		"@tiptap/pm": "3.29.2",
		"@tiptap/react": "3.29.2",
		"@tiptap/starter-kit": "3.29.2",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "1.31.0",
		"mermaid": "11.16.1",
		"prosemirror-markdown": "1.13.5",
		"prosemirror-model": "1.25.11",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-error-boundary": "6.1.2",
		"retext-english": "5.0.0",
		"retext-intensify": "7.0.0",
		"retext-passive": "5.0.0",
		"retext-readability": "8.0.0",
		"retext-simplify": "8.0.0",
		"shiki": "4.4.3",
		"tailwind-merge": "3.6.0",
		"tiptap-markdown": "0.9.0",
		"unified": "11.0.5",
		"unist-util-visit": "5.1.0",
		"usehooks-ts": "3.1.1",
		"vfile": "6.0.3",
		"vfile-message": "4.0.3",
		"zod": "4.4.3"
	}
}
