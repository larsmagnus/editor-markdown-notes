{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	// Knip's vite/vitest/typescript plugins already find `index.html` →
	// `src/main.tsx`, `src/test-setup.ts` and — via package.json `main` →
	// `out/host.js` — the extension host entry. The rest it cannot infer:
	// `.vscode-test.mjs` points at `out/test/**/*.test.js`, compiled output with
	// no path back to source; `agent-sdk-bundle.ts`, `pdf-extractor-bundle.ts`
	// and `server.ts` are each a `vite build -c vite.*.config.ts` entry knip
	// doesn't introspect, where the old single `esbuild <file>.ts` script
	// invocations were.
	"entry": [
		"src/test/**/*.test.ts",
		"src/host/agent-sdk-bundle.ts",
		"src/host/pdf-extractor-bundle.ts",
		"src/mcp/server.ts",
	],
	// `.css` is in here so the Tailwind v4 `@plugin` directive in
	// `src/globals.css` counts as usage of `tailwindcss-animate`.
	"project": ["src/**/*.{ts,tsx,css}"],
	"ignoreIssues": {
		// Vendored shadcn/ui primitives. They deliberately re-export the full
		// underlying primitive's surface whether or not this app reaches for all
		// of it, so that `pnpm dlx shadcn add` stays a clean overwrite.
		"src/components/ui/**": ["exports", "types"],
	},
	"ignoreDependencies": [
		// Downloads and runs VS Code for `pnpm test:extension`. Driven by
		// @vscode/test-cli, never imported.
		"@vscode/test-electron",
	],
}
